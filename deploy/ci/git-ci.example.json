{
  "_about": "The forge CI runner on the workstation. This file is not a secret; it names the forge, the token file, the sandbox engine and one entry per repository. deploy/ci/install.sh copies it to ~/.config/openvibe/git-ci.json when none is there.",
  "api": "https://git.openvibe.codes",
  "tokenFile": "~/.config/openvibe/git-ci.token",
  "workRoot": "~/.local/share/openvibe-git-ci/work",
  "engine": "auto",
  "concurrency": 1,
  "githubStatus": true,
  "githubContext": "forge/test",
  "pollMs": 5000,
  "heartbeatMs": 15000,
  "proxyAllow": ["registry.npmjs.org", "codeload.github.com"],
  "repos": {
    "openvibers/openvibe.shared": {
      "install_command": "npm ci --no-audit --no-fund",
      "test_command": "npm test",
      "timeout_seconds": 1800
    },
    "openvibers/openvibe.games": {
      "image": "localhost/openvibe-ci-node22:1",
      "install_command": "pnpm install --frozen-lockfile --store-dir /workspace/node_modules/.pnpm-store",
      "test_command": "pnpm typecheck && pnpm lint && pnpm test",
      "timeout_seconds": 1800
    },
    "openvibers/openvibe.network": {
      "install_command": "npm ci --no-audit --no-fund",
      "test_command": "npm test",
      "timeout_seconds": 1800
    },
    "openvibers/openvibe.chat": {
      "image": "localhost/openvibe-ci-node22-ffmpeg:1",
      "install_command": "npm ci --no-audit --no-fund",
      "test_command": "npm test",
      "timeout_seconds": 1800
    },
    "openvibers/openvibe.live": {
      "image": "localhost/openvibe-ci-node22-mediasoup:1",
      "install_command": "ONNXRUNTIME_NODE_INSTALL=skip npm ci --no-audit --no-fund",
      "test_command": "npm test",
      "timeout_seconds": 1800
    }
  }
}
